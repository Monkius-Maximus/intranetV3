{
  "name": "intranet-seplag",
  "version": "1.0.0",
  "private": true,
  "description": "Intranet SEPLAG — servidor único (Express) servindo UI + REST, com persistência local em arquivo",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "importar-funcionarios": "tsx scripts/importar-funcionarios.ts",
    "importar-aniversariantes": "tsx scripts/importar-aniversariantes.ts",
    "importar-csv": "tsx scripts/importar-csv.ts",
    "backup": "tsx scripts/backup.ts",
    "doctor": "node scripts/doctor.cjs"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.19.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
