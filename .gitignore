# Dependências
node_modules/

# Dados locais: banco JSON, segredo JWT, e QUALQUER dado real de funcionários.
# Nada disso é versionado (LGPD). Ignora o CONTEÚDO de data/, mas mantém a pasta.
data/*
!data/.gitkeep

# Dados reais (ficam só na máquina; carregados via importador).
*real*.sql
dados-reais*.sql
employees_real_data*.sql
*.xlsx

# Backups do banco (npm run backup)
backups/

# Segredos e ambiente
.env
*.env
!*.env.example
*.key

# Diversos
*.log
.DS_Store
