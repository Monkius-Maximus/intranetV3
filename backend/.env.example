# Exemplo de configuração do backend.
#
# NÃO use este arquivo em produção. No servidor, o install-server.sh gera um
# /opt/intranet/backend/.env real com DB_PASSWORD e JWT_SECRET ALEATÓRIOS
# (modo 600, dono intranet). Este exemplo serve apenas para desenvolvimento
# local na máquina de DEV.

HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intranet
DB_USER=intranet_app
DB_PASSWORD=troque-em-desenvolvimento

# Use um valor longo e aleatório. Em produção é gerado com `openssl rand -hex 48`.
JWT_SECRET=troque-este-segredo-em-desenvolvimento

# Tempo de vida do token, em segundos (28800 = 8 horas).
JWT_EXPIRES_IN=28800

# Custo do bcrypt (fator de trabalho).
BCRYPT_COST=12
