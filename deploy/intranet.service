# Serviço systemd de exemplo — mantém a intranet no ar num servidor Linux.
#
# Instalação (ajuste os caminhos/usuário para a sua máquina):
#   sudo cp deploy/intranet.service /etc/systemd/system/intranet.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now intranet
# Acompanhar: journalctl -u intranet -f

[Unit]
Description=Intranet SEPLAG (Node/Express, porta 3000)
After=network.target

[Service]
Type=simple
# Usuário sem privilégio que é dono da pasta do app:
User=intranet
WorkingDirectory=/opt/intranet
# Node extraído em /opt/node (ver DEPLOY.md §2.2); tsx vem do node_modules:
Environment=PATH=/opt/node/bin:/usr/bin:/bin
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/opt/node/bin/node node_modules/.bin/tsx src/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
